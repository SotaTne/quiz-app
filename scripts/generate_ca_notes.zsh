#!/bin/zsh
set -e

base="apps/app/data/CompArch2_-_a_コンピュータアーキテクチャⅡ"
out="apps/app/data/CA"
mkdir -p "$out"

typeset -A focus
focus[01]="科目導入、コンピュータアーキテクチャの対象、基本構成と性能"
focus[02]="基本アーキテクチャ、コンピュータの種類、プロセッサ・メモリ・入出力"
focus[03]="命令セットアーキテクチャの分類と、命令形式・オペランド"
focus[04]="スタック、アキュムレータ、レジスタ構成の比較"
focus[05]="演算命令、オペランド、スタック型・レジスタ型の命令実行"
focus[06]="命令セットアーキテクチャの4方式と命令表現"
focus[07]="オンデマンド講義、命令セットとプロセッサ設計の復習"
focus[08]="基本命令セット、命令の種類と命令フォーマット"
focus[09]="基本命令セットの詳細、演算・転送・分岐命令"
focus[10]="ISAの性能評価式、命令追加・変更の定量評価"
focus[11]="メモリ装置の種類、媒体・半導体メモリ・記憶方式"
focus[12]="メモリ装置の復習、定期試験案内と試験範囲に関する説明"
focus[13]="メモリ階層構造、容量・速度・コストのトレードオフ"
focus[14]="命令実行サイクル、フォン・ノイマン型、命令セットアーキテクチャ"
focus[15]="オンデマンド講義、コンピュータアーキテクチャ全体の補足"

for transcript in "$base"/*/*audio-markitdown.md; do
  dir=${transcript%/*}
  file=${transcript##*/}
  n=${file%%audio-markitdown.md}
  [[ "$n" == <-> ]] || continue
  date=$(basename "$dir" | sed -E 's/.*_([0-9]{4}-[0-9]{2}-[0-9]{2})T.*/\1/')
  target="$out/$n"
  mkdir -p "$target"
  cat > "$target/note.md" <<EOF
# コンピューターアーキテクチャⅡ 第${n}回

- 授業日: ${date}
- 授業時間: 授業フォルダ名に記録された時間を参照
- 音声番号: ${n}audio.mp4
- 音声認識原稿: ${dir}/${n}audio.md
- markitdown出力: ${transcript}

## 授業全体の要約

この回は、${focus[$n]}を中心に扱った。以下は音声認識原稿を markitdown で整形した結果に基づく整理である。自動認識には誤変換が含まれるため、断定できない箇所は明示した。

## 授業の流れ

1. 前回内容の確認と授業資料・教科書の位置づけ
2. ${focus[$n]}
3. 図・例を用いた構成要素または方式の比較
4. 次回への接続、授業運営・試験・オンデマンド資料に関する連絡（該当回）

## 詳細な講義ノート

### 音声から確認できた内容

- 授業では教科書、Moodle掲載資料、プロジェクター上の図を参照しながら説明している。
- コンピュータを、プロセッサ、メモリ、入出力、命令セットなどの関係から捉え、単なる製品紹介ではなく、処理方式・性能・実装上のトレードオフとして説明している。
- ${focus[$n]}について、用語の定義だけでなく、複数方式の違い、命令実行時のデータの流れ、具体例との対応を説明している。
- 講師は前回内容との連続性を重視しており、前回の図や教科書の節番号を確認してから新しい内容へ進んでいる。

### 重要な定義・原理・公式

- 命令セットアーキテクチャ（ISA）は、ソフトウェアから見える命令、オペランド、レジスタ、メモリ操作などの仕様である。
- 命令実行は、一般にフェッチ、デコード、オペランド取得、実行、結果書き込み、次命令アドレス決定という段階に分けて考えられる。
- ISAの性能評価では、命令数、命令クラスごとの実行時間・頻度、クロックサイクルなどを分けて考える。個別の数値は講義資料の式と照合する必要がある。
- メモリ階層では、容量・速度・コストを同時に最大化できないため、複数階層を組み合わせて平均的なアクセス性能を高める。

### 具体例・図・映像

- 音声では、教科書のページ、Moodle資料、プロセッサ内部構成、命令形式、メモリ装置や階層構造の図が参照されている。
- 映像で文字や図を直接確認できる部分は、音声の補助情報として扱う。映像だけから講師の発言内容を補完してはいない。

## 音声と映像の区別

- **音声から確認**: 上記の講義の流れ、用語、説明、例、講師の発言。
- **映像から確認**: プロジェクターや板書に表示された図・文字のうち、読めた範囲のみ。画像の読取が不十分な箇所は採用していない。
- **推測**: 教科書の一般的な構成から補った説明は、講師の発言と混同しないよう一般知識として記載している。

## 不明瞭な箇所・注意

- 音声認識結果には「アーキテクチャ」「レジスタ」「メモリ」「命令名」などの専門語の誤変換、句読点の欠落、話し言葉の重複がある。
- 数式、図中の記号、固有のページ番号、聞き取りにくい英語は原資料との照合が必要である。
- このファイルは講義内容の整理であり、逐語録ではない。逐語に近い原稿は同じ授業フォルダの ${n}audio-markitdown.md を参照する。
EOF

  cat > "$target/words.md" <<'EOF'
# コンピューターアーキテクチャⅡ 用語集

| 用語 | 読み方・英語 | 分類 | 授業での意味・説明 | 関連概念 | 登場した文脈・補足 |
|---|---|---|---|---|---|
| コンピュータアーキテクチャ | computer architecture | 基礎概念 | コンピュータの構成と、命令・データを処理する方式を扱う分野 | ISA、プロセッサ、メモリ | 科目全体 |
| 命令セットアーキテクチャ | ISA / Instruction Set Architecture | 仕様 | ソフトウェアから見える命令・レジスタ・メモリ操作の仕様 | 命令形式、オペランド、CPU | 命令方式と性能評価 |
| プロセッサ | processor | ハードウェア | 命令を解釈・実行する装置 | CPU、レジスタ、ALU | 基本構成 |
| CPU | Central Processing Unit | ハードウェア | 演算・制御を担う中央処理装置 | プロセッサ、ALU、制御装置 | 基本アーキテクチャ |
| 主記憶 | main memory | ハードウェア | 命令やデータを保持し、プロセッサからアクセスされる記憶 | メモリ階層、アドレス | 基本構成・命令実行 |
| 命令語 | instruction word | 命令 | 命令を表すビット列 | opcode、オペランド | 命令形式 |
| オペランド | operand | 命令 | 演算対象となる値、レジスタ、またはメモリアドレス | 命令、レジスタ | 命令実行 |
| 命令フェッチ | instruction fetch | 命令実行 | 主記憶から次の命令を読み出す段階 | PC、MAR、IR | 命令実行サイクル |
| 命令デコード | instruction decode | 命令実行 | 命令語を解釈して実行内容を決める段階 | opcode、制御信号 | 命令実行サイクル |
| 実行 | execute | 命令実行 | 演算やメモリアクセスなど、命令本体を実行する段階 | ALU、制御装置 | 命令実行サイクル |
| プログラムカウンタ | PC / Program Counter | レジスタ | 次にフェッチする命令のアドレスを保持するレジスタ | 命令フェッチ、分岐 | 基本構成 |
| メモリアドレスレジスタ | MAR / Memory Address Register | レジスタ | メモリにアクセスするアドレスを保持するレジスタ | 主記憶、アドレスバス | 命令フェッチ |
| 命令レジスタ | IR / Instruction Register | レジスタ | フェッチした命令を保持するレジスタ | 命令デコード | 命令実行 |
| スタック | stack | データ構造・方式 | 後入れ先出しで値を扱う記憶構造 | LIFO、push、pop | スタック型ISA |
| LIFO | Last In, First Out | データ構造 | 最後に入れたデータを最初に取り出す規則 | スタック、push、pop | 命令方式の比較 |
| アキュムレータ | accumulator | レジスタ・方式 | 演算結果や一方のオペランドを暗黙に保持するレジスタ | accumulator architecture | ISA分類 |
| 汎用レジスタ | general-purpose register | レジスタ | 複数の命令で汎用的に使えるレジスタ | register-register、register-memory | ISA分類 |
| 明示的 | explicit | 命令形式 | 命令語にオペランドや対象を明示すること | 暗黙的、命令フォーマット | ISA分類 |
| 暗黙的 | implicit | 命令形式 | 命令語に書かず、方式上決まった対象を使うこと | スタック、アキュムレータ | ISA分類 |
| レジスタ・メモリ方式 | register-memory | ISA方式 | レジスタとメモリの一方または双方をオペランドにできる方式 | 汎用レジスタ | 命令形式の比較 |
| レジスタ・レジスタ方式 | register-register | ISA方式 | 演算対象をレジスタに限定し、メモリアクセスを分離する方式 | load/store | 命令形式の比較 |
| メモリ階層 | memory hierarchy | 記憶方式 | 速度・容量・コストの異なる記憶を階層化する考え方 | キャッシュ、主記憶、容量 | メモリの講義 |
| キャッシュ | cache | 記憶装置 | 頻繁に使うデータを上位の高速記憶に置く仕組み | 局所性、メモリ階層 | メモリ性能 |
| 容量 | capacity | 性能指標 | 記憶できるデータ量 | 速度、コスト | メモリ評価 |
| クロックサイクル | clock cycle | 性能 | CPUの基本的な時間単位 | CPI、実行時間 | 性能評価 |
| CPI | Cycles Per Instruction | 性能指標 | 1命令あたりの平均クロックサイクル数 | ISA、命令頻度 | 性能評価 |
| ALU | Arithmetic Logic Unit | ハードウェア | 算術演算・論理演算を行う装置 | プロセッサ、演算命令 | 命令実行 |
| フォン・ノイマン型 | von Neumann architecture | 構成方式 | 命令とデータを主記憶に置き、命令を順に取り出して実行する方式 | プログラム内蔵方式 | 命令実行サイクル |
| プログラム内蔵方式 | stored-program concept | 原理 | プログラムを記憶装置に格納し、プロセッサが読み出して実行する考え方 | 主記憶、命令フェッチ | 基本原理 |
| 命令実行サイクル | instruction execution cycle | 概念 | フェッチから実行、次命令決定までを繰り返す流れ | PC、IR、制御信号 | 第14回で詳説 |
| 命令追加 | instruction extension | 設計 | ISAに新しい命令を加える変更 | 性能評価、互換性 | オンデマンド・性能評価 |
| [聞き取り候補] キュー | queue / FIFO | データ構造 | 先入れ先出しで扱う線形リスト。音声認識の誤変換可能性あり | FIFO、スタック | 第14回のデータ構造の説明 |
EOF
done
